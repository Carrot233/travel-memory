# Copy the keys you need into local.properties. That file is not committed.
# sdk.dir is created by Android Studio.
# AMAP_KEY is a Web service key from https://lbs.amap.com/ (input tips / Web服务).
# Leave it empty to keep place search disabled; spots can still be saved with typed coordinates.
sdk.dir=/path/to/Android/sdk
AMAP_KEY=
